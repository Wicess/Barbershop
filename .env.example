# Where the server keeps the shop's master copy of the data.
# Local SQLite file (self-hosted on a shop PC or VPS):
DATABASE_URL=file:data/barbershop.db
# Or a Turso (hosted SQLite/libSQL) database, e.g. when deploying to Vercel:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...

# Secret used to sign device tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me

# Where the server keeps its automatic daily copies (self-hosted file database only)
# BACKUP_DIR=data/backups
