{
  "id": "/",
  "name": "Barbershop Manager",
  "short_name": "Barbershop",
  "description": "Sales, staff pay, expenses and profit for your barbershop.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#120d0a",
  "theme_color": "#120d0a",
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "categories": ["business", "finance", "productivity"],
  "shortcuts": [
    { "name": "New sale", "short_name": "Sell", "url": "/#/sell", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today's sales", "short_name": "Sales", "url": "/#/sales", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Close the day", "short_name": "Close day", "url": "/#/close", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
